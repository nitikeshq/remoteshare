{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteShare",
  "version": "0.1.12",
  "identifier": "com.remoteshare.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoteShare",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright RemoteShare contributors",
    "shortDescription": "Share one keyboard and mouse across computers.",
    "longDescription": "RemoteShare shares one keyboard and mouse across trusted computers on the same network, with a staged path for internet relay support.",
    "targets": ["dmg", "nsis", "deb"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
