{
  "name": "remoteshare",
  "version": "0.1.13",
  "description": "Cross-platform keyboard and mouse sharing for trusted computers on a private network.",
  "private": true,
  "license": "MIT",
  "author": "RemoteShare contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitikeshq/remoteshare.git"
  },
  "homepage": "https://github.com/nitikeshq/remoteshare#readme",
  "bugs": {
    "url": "https://github.com/nitikeshq/remoteshare/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "frontend:dev": "vite --host 127.0.0.1",
    "build": "tauri build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "doctor": "node scripts/package-doctor.mjs",
    "clean:debug-cache": "node scripts/clean-debug-cache.mjs",
    "test:clean-debug-cache": "node scripts/test-clean-debug-cache.mjs",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml -j 1",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -j 1 -- --test-threads=1 --nocapture",
    "check:rustfmt": "node scripts/check-rustfmt.mjs",
    "test:rustfmt": "node scripts/test-rustfmt-check.mjs",
    "test:ci-annotation": "node scripts/test-ci-run-with-annotation.mjs",
    "checksums:installers": "node scripts/installer-checksums.mjs",
    "test:checksums": "node scripts/test-installer-checksums.mjs",
    "verify:installers": "node scripts/verify-installer-artifacts.mjs",
    "test:installers": "node scripts/test-installer-verifier.mjs",
    "verify:publish-artifacts": "node scripts/verify-publish-artifacts.mjs",
    "test:publish-artifacts": "node scripts/test-publish-artifacts.mjs",
    "prepare:release-assets": "node scripts/prepare-release-assets.mjs",
    "test:release-assets": "node scripts/test-prepare-release-assets.mjs",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs",
    "test:release-manifest": "node scripts/test-release-manifest-verifier.mjs",
    "test:release-artifacts-lib": "node scripts/test-release-artifacts-lib.mjs",
    "test:disk": "node scripts/test-disk-preflight.mjs",
    "test:release-summary": "node scripts/test-release-summary.mjs",
    "verify:lan-smoke-report": "node scripts/verify-lan-smoke-report.mjs",
    "test:lan-smoke-report": "node scripts/test-lan-smoke-report-verifier.mjs",
    "prepare:lan-smoke-report": "node scripts/prepare-lan-smoke-report.mjs",
    "test:prepare-lan-smoke-report": "node scripts/test-prepare-lan-smoke-report.mjs",
    "release:smoke-rows": "node scripts/smoke-report-release-rows.mjs",
    "test:smoke-rows": "node scripts/test-smoke-report-release-rows.mjs",
    "release:candidate-summary": "node scripts/release-candidate-summary.mjs",
    "test:release-candidate-summary": "node scripts/test-release-candidate-summary.mjs",
    "verify:release-readiness": "node scripts/verify-release-readiness.mjs",
    "test:release-readiness": "node scripts/test-release-readiness-verifier.mjs",
    "verify:github-release-assets": "node scripts/verify-github-release-assets.mjs",
    "test:github-release-assets": "node scripts/test-github-release-assets-verifier.mjs",
    "download:release-assets": "node scripts/download-release-assets.mjs",
    "test:download-release-assets": "node scripts/test-download-release-assets.mjs",
    "release:summary": "node scripts/release-summary.mjs",
    "check:disk": "node scripts/check-disk-space.mjs",
    "verify": "npm run typecheck && npm run check:rust && npm run build:frontend",
    "verify:release-scripts": "npm run test:checksums && npm run test:installers && npm run test:publish-artifacts && npm run test:release-assets && npm run test:release-manifest && npm run test:release-artifacts-lib && npm run test:clean-debug-cache && npm run test:disk && npm run test:release-summary && npm run test:lan-smoke-report && npm run test:prepare-lan-smoke-report && npm run test:smoke-rows && npm run test:release-candidate-summary && npm run test:release-readiness && npm run test:github-release-assets && npm run test:download-release-assets && npm run test:rustfmt && npm run test:ci-annotation && npm run release:summary && npm run doctor",
    "verify:release": "npm run check:disk && npm run verify && npm run verify:release-scripts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "vite": "^7.0.0",
    "typescript": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
